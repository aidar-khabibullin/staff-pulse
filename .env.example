# Порт, на котором Nginx (клиент) будет доступен на хосте
CLIENT_PORT=8080

# Origin, с которого backend будет разрешать CORS-запросы.
# По умолчанию вычисляется из CLIENT_PORT — переопределяйте только при нестандартной схеме проксирования.
CORS_ORIGIN=http://localhost:8080

# Интервал генерации live-патчей на сервере, секунды
LIVE_UPDATE_INTERVAL_SECONDS=1
